# ==============================================================================
# St. Lawrence Junior School - Version Control Exclusion
# ==============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Database backups & raw SQL dumps
*.sql
*.sql.gz
*.sqlite
*.db
database/schema/*
!database/schema/.gitkeep
!database/.htaccess

# Uploaded user files
backend/uploads/admissions/*
!backend/uploads/admissions/.gitkeep
backend/uploads/gallery/*
!backend/uploads/gallery/.gitkeep
backend/uploads/library/*
!backend/uploads/library/.gitkeep
backend/uploads/profiles/*
!backend/uploads/profiles/.gitkeep
backend/uploads/teachers/*
!backend/uploads/teachers/.gitkeep
backend/uploads/videos/*
!backend/uploads/videos/.gitkeep
img/testimonials/testimonial_*

# Logs & temporary files
*.log
error_log
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.zip
scratch/
scratch_test_uploads/

# Dependencies
backend/vendor/phpmailer/phpmailer/test/
backend/vendor/phpmailer/phpmailer/.git/

# IDE & OS artifacts
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
